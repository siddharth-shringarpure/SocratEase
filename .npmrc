# Block all install scripts by default (supply chain attack prevention)
ignore-scripts=true

# Strict peer dependencies
strict-peer-dependencies=false

# Auto-install peers
auto-install-peers=true

# Shamefully hoist for better compatibility
shamefully-hoist=false

# Explicitly allowlisted build scripts only
# - sharp: native image processing bindings (required for Next.js image optimization)
# - unrs-resolver: native resolver bindings (required for eslint-config-next)
allowed-scripts=sharp,unrs-resolver
