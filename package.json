{
  "name": "next-flask",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "flask-dev": "FLASK_DEBUG=1 python3.10 -m ensurepip --upgrade && python3.10 -m pip install --upgrade pip && python3.10 -m pip install -r requirements.txt && python3.10 scripts/download_backend_models.py && PYTHONPATH=$PYTHONPATH:. python3.10 -c \"from dotenv import load_dotenv; load_dotenv(); from flask import Flask; from api.index import app; app.run(port=5000, debug=True)\"",
    "next-dev": "next dev",
    "dev": "next dev",
    "docker": "BACKEND_URL=http://localhost:5000 docker compose up",
    "docker:dev": "concurrently \"npm run docker\" \"npm run dev\"",
    "dev:fast": "BACKEND_URL=http://localhost:5000 node scripts/dev-flask.js",
    "prebuild": "next telemetry disable",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "download-models": "node scripts/download-models.js",
    "download-backend-models": "python3.10 scripts/download_backend_models.py",
    "setup": "npm run download-models && npm run download-backend-models"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.4",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@types/crypto-js": "^4.2.2",
    "@types/recharts": "^1.8.29",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^8.0.1",
    "crypto-js": "^4.2.0",
    "face-api.js": "^0.20.0",
    "framer-motion": "^12.6.3",
    "lucide-react": "^0.483.0",
    "next": "^14.2.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.19",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-config-next": "14.1.0",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.3.3"
  }
}
